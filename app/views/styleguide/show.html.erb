<style>
  :root {
    --brand-color:#f31a7c; --primary-color:rgb(21,21,21); --page-bg-color:#f8f8f8;
    --card-bg-color:rgba(255,255,255,.8); --card-border-color:#fff;
    --gray-content:#959595; --success-color:#3cbd2c;
    --timeline-line-color:rgba(0,0,0,.04); --dot-color:#95959580;
    --card-shadow:0 1px 3px rgba(0,0,0,.05),0 2px 7px rgba(0,0,0,.03);
    --segment-bg-color:rgba(21,21,21,.04); --slider-bg-color:#fff;
  }
  .dark {
    --brand-color:#f98dbe; --primary-color:#fff; --page-bg-color:#151515;
    --card-bg-color:rgba(255,255,255,.04); --card-border-color:rgba(255,255,255,.04);
    --gray-content:#b5b5b5; --success-color:#77d86b;
    --timeline-line-color:rgba(255,255,255,.08); --dot-color:#ffffff52;
    --card-shadow:0 1px 4px rgba(0,0,0,.4);
    --segment-bg-color:rgba(255,255,255,.08); --slider-bg-color:#232323;
  }
  .timeline-line { border-left: 2px dashed var(--timeline-line-color); }
  .luma-card {
    background: var(--card-bg-color);
    border: 1px solid var(--card-border-color);
    box-shadow: var(--card-shadow);
    border-radius: 12px;
    transition: border-color .2s cubic-bezier(.4,0,.2,1), box-shadow .2s cubic-bezier(.4,0,.2,1);
  }
  .luma-card:hover {
    box-shadow: 0px 28px 17px rgba(0,0,0,.01), 0px 12px 12px rgba(0,0,0,.02), 0px 3px 7px rgba(0,0,0,.02);
  }
  .luma-icon { display:inline-block; vertical-align:-3px; flex-shrink:0; }
  .lux-button-switcher {
    border-radius: 8px;
    background-color: var(--segment-bg-color);
    padding: 4px;
    display: flex;
  }
  .lux-button-switcher button {
    flex: 1;
    border-radius: 4px;
    padding: 4px 14px;
    text-align: center;
  }
  .lux-button-switcher button.active {
    background-color: var(--slider-bg-color);
    color: var(--primary-color);
    box-shadow: var(--card-shadow);
  }
  .lux-button-switcher button:not(.active) { color: var(--gray-content); }
</style>

