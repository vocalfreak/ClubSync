# Copy this to .env, fill in real values, then: chmod 600 .env
# .env is already git-ignored — never commit the real one.

POSTGRES_PASSWORD=changeme
RAILS_ENV=production

# Apify API token — raw token string only (apify_api_...), never a full run-sync URL.
# Sent to Apify as an Authorization: Bearer header. See docs/DATA_INGESTION_IMPLEMENTATION_PLAN.md §6.
APIFY_API_TOKEN=
APIFY_RESULTS_LIMIT=15        # max posts fetched per account per run (Apify sync ceiling is 300s)

GEMINI_API_KEY=

# Discord webhooks (see docs/HEALTH_MONITORING_PLAN.md §4.1 for setup)
DISCORD_LOG_WEBHOOK_URL=       # webhook for #clubsync-log
DISCORD_ALERT_WEBHOOK_URL=     # webhook for #clubsync-alerts (configured in healthchecks.io dashboard, not read by app)

# healthchecks.io ping URL (see docs/HEALTH_MONITORING_PLAN.md §5)
HEALTHCHECKS_PING_URL=         # e.g. https://hc-ping.com/<check-uuid>
