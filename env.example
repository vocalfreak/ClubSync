# Template for the environment this app needs. Copy to .env and fill in real
# values. NEVER commit a filled-in .env -- it is git-ignored via /.env*
# (.env.development and .env.test are ignored too).
#
#   cp env.example .env   &&   chmod 600 .env
#
# Each machine needs its own .env. The box's production values are NOT a copy of
# a laptop's: DATABASE_URL, SECRET_KEY_BASE and POSTGRES_PASSWORD exist only in
# production, and B2/Gemini/Apify credentials may differ per environment.

# --- Rails core (no default; the app will not boot without these) -------------

# Generate with `bin/rails secret`. Set once and never regenerate: rotating it
# invalidates every active session.
SECRET_KEY_BASE=

# Host `db`, not `localhost` -- the app reaches Postgres over the compose
# network, not a published port. Matches POSTGRES_USER/POSTGRES_DB in
# docker-compose.yml, with POSTGRES_PASSWORD below.
DATABASE_URL=postgres://clubsync:<password>@db/clubsync_production

# Read by docker-compose to set the db service's POSTGRES_PASSWORD, not by app
# code. Must match the password embedded in DATABASE_URL above.
POSTGRES_PASSWORD=

# Rails/tailor. All optional; the values shown are what the app falls back to.
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
# WEB_CONCURRENCY= # Puma workers; leave unset for a single-container deploy.
# PORT=3000        # Container-internal port. The HOST port is 3010 and is set in
#                   # docker-compose.yml, not here.

# --- Gemini (extraction, dedup tiebreak, quota alerting) ---------------------

GEMINI_API_KEY=
# Primary model. The embedding model is a SEPARATE key -- reusing this one is
# forbidden, since embeddings and generation are different model families.
GEMINI_MODEL=
GEMINI_EMBED_MODEL=
# Ordered, comma-separated fallbacks retried across on transient Gemini errors
# (timeout / rate limit / server). Blank means no fallback.
GEMINI_FALLBACK_MODELS=
# "low" by default. Higher costs more latency per extraction.
GEMINI_THINKING_LEVEL=low
# Daily soft caps. When a run crosses 80% of either, one alert goes to
# #clubsync-alerts. Inert while unset -- confirm the real number on the AI Studio
# dashboard before setting a cap you cannot afford to hit.
GEMINI_DAILY_REQUESTS=
GEMINI_DAILY_TOKENS=

# --- Backblaze B2 (image storage) -------------------------------------------

B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# S3-compatible endpoint, e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
B2_REGION=
# Optional. The Cloudflare-served image host, e.g.
# https://files.cyberjayahappenings.me -- ObjectStore#get_url prefers this over
# the raw B2 URL so images are cached at the edge instead of spending B2's free
# 2,500/day Class B download transactions on every page view. Leave blank
# locally and it falls back to the raw B2 URL.
PUBLIC_IMAGE_BASE_URL=

# --- Apify (Instagram scraping) ----------------------------------------------

APIFY_API_TOKEN=
# Blank uses the client's DEFAULT_RESULTS_LIMIT.
APIFY_RESULTS_LIMIT=

# --- Reporting --------------------------------------------------------------

# Per-run ingestion summary to #clubsync-log.
DISCORD_LOG_WEBHOOK_URL=
# Detected Gemini outage to #clubsync-alerts. Distinct from the log webhook --
# leaving this blank means outages are logged and silently dropped.
DISCORD_ALERT_WEBHOOK_URL=
# healthchecks.io check UUID. The app pings /start at run begin, /fail on crash,
# and a bare success otherwise. Blank disables pinging entirely.
HEALTHCHECKS_PING_URL=

# --- Local only -------------------------------------------------------------

# clubsync:retag_csrw previews instead of writing when true.
DRY_RUN=false
